YII_ENV=dev
YII_DEBUG=true

DB_HOST=db
DB_PORT=5432
DB_NAME=tgteam
DB_USER=tgteam
DB_PASSWORD=tgteam

BOT_TOKEN=123456:REPLACE_ME
BOT_USERNAME=your_bot_username
CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# Telegram Web App (Mini App) tugmalari uchun to'liq https manzil (masalan https://your-domain.uz).
APP_BASE_URL=https://your-domain.uz

# Пароль для веб-страницы запуска миграций (/index.php?r=system/migrate)
SYSTEM_MIGRATE_TOKEN=change_me_please

# Логин/пароль для веб-админки (/index.php?r=admin/index)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change_me_please

# Telegram ID (через запятую), которым разрешено создавать встречи/отмечать посещаемость без ограничения по времени.
# Оставить пустым в продакшене — это только для тестирования.
TEST_BYPASS_TELEGRAM_IDS=

# ngrok — только для локальной разработки (контейнер в docker-compose), получить на https://dashboard.ngrok.com
NGROK_AUTHTOKEN=
